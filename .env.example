NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Provider-neutral Postgres URLs. Any Postgres works (Supabase, Neon, RDS, self-hosted Docker).
DATABASE_URL=postgresql://user:pass@host:6543/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:pass@host:5432/dbname

# JWT — 32+ char random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-real-32plus-char-secret
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
