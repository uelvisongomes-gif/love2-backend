generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String   @unique
  passwordHash   String
  photoUrl       String?  @db.Text
  historyPinHash String?  // argon2 hash do PIN pessoal p/ Minha História
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  coupleAsA      Couple?  @relation("CoupleUserA")
  coupleAsB      Couple?  @relation("CoupleUserB")
}

model Couple {
  id        String   @id @default(cuid())
  userAId   String   @unique
  userBId   String   @unique
  createdAt DateTime @default(now())
  userA     User     @relation("CoupleUserA", fields: [userAId], references: [id])
  userB     User     @relation("CoupleUserB", fields: [userBId], references: [id])
}

model CoupleInvite {
  id           String    @id @default(cuid())
  inviterId    String
  inviteeEmail String
  code         String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([inviterId])
}

model Consent {
  id        String   @id @default(cuid())
  userId    String
  scope     String
  version   String
  createdAt DateTime @default(now())

  @@index([userId, scope])
}

model AuditLog {
  id      String   @id @default(cuid())
  actorId String
  action  String
  target  String
  at      DateTime @default(now())

  @@index([actorId])
}

model LoveMessage {
  id             String   @id @default(cuid())
  userId         String
  context        String
  role           String
  content        String
  safetyCategory String?
  citations      Json?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model Source {
  id        String   @id @default(cuid())
  pillar    String
  title     String
  url       String   @unique
  content   String
  createdAt DateTime @default(now())

  // The `embedding vector(1024)` column is added via a raw SQL migration
  // (Prisma has no native pgvector type). See migration add_source_embedding.
  @@index([pillar])
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  loveLanguagesRanking Json?
  pillarScores         Json?
  preferences          Json?
  relationshipYears    Int?
  hasChildren          Boolean?
  livingTogether       Boolean?
  timezone             String   @default("America/Sao_Paulo")
  // Dados pessoais expandidos (Etapa 2)
  birthDate            DateTime? @db.Date
  gender               String?   // mulher | homem | naobinario | prefiro_nao_dizer
  occupation           String?
  location             String?   // cidade
  healthNotes          String?   // texto livre — condições, remédios, alergias
  // Relacionamento
  civilStatus          String?   // namoro | noivado | casados | uniao_estavel
  relationshipStart    DateTime? @db.Date
  howMet               String?   // texto curto
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Filhos do casal — saúde e cuidados afetam o casal
model Child {
  id             String    @id @default(cuid())
  coupleId       String?
  createdBy      String
  name           String
  birthDate      DateTime? @db.Date
  gender         String?   // menino | menina | outro
  photoUrl       String?   @db.Text // base64 small
  parentage      String?   // biologico_ambos | biologico_um | adotado | enteado
  livesWith      String?   // conosco | pai | mae | alternado
  schoolInfo     String?
  healthNotes    String?   // condições, alergias, remédios
  personality    String?   // texto livre
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([coupleId])
  @@index([createdBy])
}

model SafetyScreening {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  hasViolenceHistory     Boolean
  hasSuicidalIdeation    Boolean
  hasSubstanceAbuse      Boolean
  hasChildSafetyConcerns Boolean
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CheckIn {
  id                  String   @id @default(cuid())
  userId              String
  date                DateTime @db.Date
  moodOverall         Int
  intimacyToday       Boolean  @default(false)
  dateNightToday      Boolean  @default(false)
  // Novos campos do check-in v2 (sliders 1-5)
  connectionScore     Int?
  communicationScore  Int?
  affectionScore      Int?
  partnershipScore    Int?
  emotionalScore      Int?
  openNote            String?
  sharedWithPartner   Boolean  @default(false)
  // Etapa 3 — sinais do dia
  sleepHours          Float?   // horas de sono na noite anterior
  exercisedToday      Boolean  @default(false)
  frictionToday       Boolean  @default(false) // atrito, briga
  frictionNote        String?
  positiveMemory      String?  // uma coisa boa que aconteceu hoje
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  events              Event[]

  @@unique([userId, date])
  @@index([userId, date])
}

model Event {
  id          String  @id @default(cuid())
  checkInId   String
  kind        String
  pillar      String
  intensity   Int
  description String
  checkIn     CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  mood      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model CoupleTask {
  id           String    @id @default(cuid())
  coupleId     String?   // null quando o usuário ainda não tem parceiro (tarefa solo)
  pillar       String
  title        String
  description  String?
  dueBy        DateTime?
  createdBy    String
  completedByA Boolean   @default(false)
  completedByB Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Novos campos v2
  category     String?   // casa | filhos | financas | tempo_casal | metas
  assignedTo   String?   // userId específico, ou null = ambos
  recurrence   String?   // null (não repete) | daily | weekly | monthly
  remindAt     DateTime? // horário exato do lembrete (browser notification)

  @@index([coupleId, createdAt])
  @@index([coupleId, category])
  @@index([assignedTo])
}

model Conflict {
  id          String   @id @default(cuid())
  coupleId    String
  initiatorId String
  targetId    String
  status      String
  pillar      String?
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([coupleId, createdAt])
  @@index([initiatorId])
  @@index([targetId])
}

model ConflictMessage {
  id         String   @id @default(cuid())
  conflictId String
  side       String
  authorId   String
  role       String
  content    String
  createdAt  DateTime @default(now())

  @@index([conflictId, createdAt])
}

model ConflictBlock {
  id         String   @id @default(cuid())
  conflictId String
  order      Int
  content    String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([conflictId, order])
}

model TwoFactorCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Sessão de mediação conjunta — dois parceiros respondem etapas privadas + LOVE sintetiza
model MediationSession {
  id            String    @id @default(cuid())
  coupleId      String
  initiatorId   String
  targetId      String
  status        String    @default("in_progress")  // in_progress | ready_for_synthesis | agreed | canceled
  topic         String?   // sobre o que é
  synthesis     String?   // texto neutro gerado pela LOVE
  proposedAgreement String?
  agreementId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([coupleId, createdAt])
  @@index([initiatorId])
  @@index([targetId])
}

model MediationStep {
  id          String    @id @default(cuid())
  sessionId   String
  userId      String   // quem responde
  step        String    // fatos | sentimento | necessidade | ponto_do_outro
  answer      String
  submittedAt DateTime  @default(now())

  @@unique([sessionId, userId, step])
  @@index([sessionId])
}

// Ciclo menstrual — configuração pessoal do usuário
model CycleProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  averageCycleDays   Int       @default(28)
  averagePeriodDays  Int       @default(5)
  premenstrualDays   Int       @default(5)  // dias antes que a pessoa costuma sentir mudança (TPM: média 5-7)
  // Consentimento pra compartilhar
  shareWithPartner   Boolean   @default(false)
  sharePeriodStart   Boolean   @default(false)
  sharePreMenstrual  Boolean   @default(false)
  sharePreferences   Boolean   @default(false)
  // Preferências pessoais (JSON: array de strings escolhidas)
  carePreferences    Json?     // ex: ["mais_carinho", "mais_espaco", "paciencia"]
  customNote         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Log de notificações enviadas pro parceiro — evita duplicar
model CycleNotificationLog {
  id        String   @id @default(cuid())
  userId    String   // dona do ciclo
  kind      String   // pre_menstrual | period_start
  sentDate  DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, kind, sentDate])
  @@index([userId])
}

// Períodos menstruais registrados
model CyclePeriod {
  id         String    @id @default(cuid())
  userId     String
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())

  @@unique([userId, startDate])
  @@index([userId])
}

// Registro diário opcional de sintomas
model CycleDailyLog {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  @db.Date
  symptoms  Json      // { mood: string, cramp: bool, headache: bool, ... }
  note      String?
  createdAt DateTime  @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// Item genérico do casal — domain: filhos | metas | tempo_casal
model LifeItem {
  id             String    @id @default(cuid())
  coupleId       String?
  createdBy      String
  domain         String    // filhos | metas | tempo_casal
  title          String
  description    String?
  scheduledAt    DateTime?
  completedAt    DateTime?
  responsibleId  String?
  recurring      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([coupleId, domain])
  @@index([createdBy, domain])
  @@index([scheduledAt])
}

// Item financeiro do casal — kind: conta_mensal | compra_grande | decisao
model FinanceItem {
  id             String    @id @default(cuid())
  coupleId       String?
  createdBy      String
  kind           String
  title          String
  amount         Decimal?  @db.Decimal(12, 2)
  category       String?   // moradia | alimentacao | transporte | saude | lazer | educacao | outros
  dueBy          DateTime?
  paidAt         DateTime?
  responsibleId  String?
  recurring      Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([coupleId, kind])
  @@index([createdBy, kind])
  @@index([dueBy])
}

// Assinatura de push notification do navegador (Web Push API)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Log de notificações já enviadas pra não duplicar
model TaskReminderLog {
  id        String   @id @default(cuid())
  taskId    String
  remindAt  DateTime
  sentAt    DateTime @default(now())

  @@unique([taskId, remindAt])
  @@index([taskId])
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Narrativa do casal — visão, história, valores, rituais (compartilhado)
model CoupleNarrative {
  id                String   @id @default(cuid())
  coupleId          String   @unique
  ourVision         String?  // o que queremos ser juntos
  ourHistory        String?  // como se conheceram, marcos
  ourValues         String?
  connectionRituals String?  // rituais que nos aproximam
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Como vejo meu parceiro — cada um escreve o seu (privado por padrão)
model PartnerPerception {
  id                String   @id @default(cuid())
  userId            String   @unique
  admiration        String?  // o que admiro nele/nela
  gratitude         String?  // pelo que sou grato(a)
  worries           String?  // o que me preocupa
  hopes             String?  // o que espero
  visibleToPartner  Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// Desafios pessoais que cada um enxerga — privado por padrão
model PersonalChallenge {
  id                String   @id @default(cuid())
  userId            String
  title             String
  description       String?
  visibleToPartner  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

// Minha História — registros pessoais protegidos por PIN (só o dono lê)
model HistoryEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  category  String?  // ex-relacionamentos | familia | trabalho | outro
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// Log de tentativas de PIN — brute force
model HistoryPinAttempt {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Acordo entre parceiros gerado a partir do modo "Tem Conflito".
// Salvo por quem criou; ambos do casal veem.
// status: em_andamento | cumprido | precisa_revisar
model Agreement {
  id          String    @id @default(cuid())
  coupleId    String?
  createdBy   String
  title       String
  content     String
  pillar      String?
  status      String    @default("em_andamento")
  conflictId  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([coupleId, createdAt])
  @@index([createdBy, createdAt])
}
